# Dummy values used by env-loading.test.ts when no real .env.local / .env is
# present (e.g. CI). These values are intentionally fake — no live services are
# contacted during unit tests.
DATABASE_URL=mongodb://localhost:27017/knotengine_test
AUTH_SECRET=ci-test-auth-secret-minimum-16-chars
INTERNAL_SECRET=ci-test-internal-secret-16chars
NEXT_PUBLIC_API_URL=http://localhost:5050
REDIS_URL=redis://localhost:6379
