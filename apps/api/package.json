    "@qodinger/knot-database": "workspace:*",
    "@qodinger/knot-types": "workspace:*",
    "@types/ioredis": "^5.0.0",
    "axios": "^1.16.1",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "bullmq": "^5.76.8",
