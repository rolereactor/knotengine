# ══════════════════════════════════════════════════════════════════════
# KnotEngine — Self-Hosted Production Environment
# ══════════════════════════════════════════════════════════════════════
# Self-hosting is FREE. Set SELF_HOSTED=true below.
# All features are unlocked, zero platform fees.
#
# Quick setup:
#   1. cp .env.production .env.local
#   2. Edit values marked with <CHANGE>
#   3. docker compose up -d --build
# ══════════════════════════════════════════════════════════════════════

# ── Environment ──
NODE_ENV=production

# ── Core Infrastructure ──
DATABASE_URL="mongodb://knotadmin:<CHANGE_PASSWORD>@mongodb:27017/knotengine?authSource=admin"
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"
PORT=5050

# ── Service URLs ──
NEXT_PUBLIC_API_URL="https://your-api-domain.com"
NEXT_PUBLIC_CHECKOUT_URL="https://your-checkout-domain.com"
NEXT_PUBLIC_DASHBOARD_URL="https://your-dashboard-domain.com"
CHECKOUT_BASE_URL="https://your-checkout-domain.com"
DASHBOARD_URL="https://your-dashboard-domain.com"
PUBLIC_URL="https://your-api-domain.com"

# ── Security & Secrets ──
# Generate with: openssl rand -hex 32
INTERNAL_SECRET="<CHANGE_TO_LONG_RANDOM_STRING>"
AUTH_SECRET="<CHANGE_TO_LONG_RANDOM_STRING>"

# ── Blockchain ──
BITCOIN_NETWORK="mainnet"

# ── Blockchain Providers ──
# Get free API keys at:
#   Tatum: https://dashboard.tatum.io
#   Alchemy: https://www.alchemy.com
TATUM_API_KEY="<CHANGE_ADD_YOUR_TATUM_KEY>"
TATUM_WEBHOOK_SECRET="<CHANGE_ADD_YOUR_WEBHOOK_SECRET>"
ALCHEMY_API_KEY="<CHANGE_ADD_YOUR_ALCHEMY_KEY>"
ALCHEMY_AUTH_TOKEN=""
ALCHEMY_NOTIFY_WEBHOOK_ID=""
ALCHEMY_WEBHOOK_SIGNING_KEY=""

# ── Deployment Mode ──
SELF_HOSTED=true

# ── Billing & Business Logic ──
MIN_INVOICE_AMOUNT=1.00
MIN_FEE_USD=0.05
WELCOME_CREDIT_AMOUNT=5.00
AFFILIATE_SIGNUP_BONUS=0.00
# Your wallet for fee collection (STABLECOINS ONLY: USDT/USDC)
PLATFORM_FEE_WALLET_EVM="<CHANGE_ADD_YOUR_ETH_ADDRESS>"
POLYGON_RPC_URL=""
# Float management (AAVE integration)
PLATFORM_WALLET_ADDRESS=""
AAVE_POOL_ADDRESS=""

# ── Email Configuration ──
# Resend (recommended for production)
# Get from: https://resend.com -> API Keys
RESEND_API_KEY=""
FROM_EMAIL="KnotEngine <noreply@yourdomain.com>"

# Gmail SMTP (alternative)
# Get from: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT=587

# ── Media Storage ──
# Get from: https://cloudinary.com -> Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── OAuth Providers ──
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://your-dashboard-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub: https://github.com/settings/developers
# Redirect URI: https://your-dashboard-domain.com/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Developer Tools ──
KNOT_API_KEY=""
KNOT_WEBHOOK_SECRET=""
ALLOW_SIMULATION=""
TEST_EMAIL=""