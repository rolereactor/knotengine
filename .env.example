# ══════════════════════════════════════════════
# KnotEngine — Environment Configuration
# ══════════════════════════════════════════════
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local

# ── Environment ──
NODE_ENV=development

# ── Core Infrastructure ──
DATABASE_URL="mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/knotengine?retryWrites=true&w=majority"
REDIS_URL="redis://localhost:6379"
PORT=5050

# ── Service URLs ──
NEXT_PUBLIC_API_URL="http://localhost:5050"
NEXT_PUBLIC_CHECKOUT_URL="http://localhost:5051"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:5052"
CHECKOUT_BASE_URL="http://localhost:5051"
DASHBOARD_URL="http://localhost:5052"
PUBLIC_URL="https://your-public-api.com"

# ── Security & Secrets ──
# Internal secret for Dashboard <-> API communication
INTERNAL_SECRET="change_me_generate_with_openssl_rand_hex"

# NextAuth secret (generate: openssl rand -base64 32)
AUTH_SECRET="change_me"

# ── Blockchain ──
BITCOIN_NETWORK="testnet"

# ── Blockchain Providers ──
# Tatum (Bitcoin + EVM monitoring)
# Get from: https://dashboard.tatum.io
TATUM_API_KEY=""
TATUM_WEBHOOK_SECRET=""

# Alchemy (EVM backup RPC + Notify webhooks)
# Get from: https://www.alchemy.com -> Dashboard -> API Keys
ALCHEMY_API_KEY=""
ALCHEMY_AUTH_TOKEN=""
ALCHEMY_NOTIFY_WEBHOOK_ID=""
ALCHEMY_WEBHOOK_SIGNING_KEY=""

# ── Deployment Mode ──
# Set to "true" to enable self-hosted mode (all features unlocked, no billing)
SELF_HOSTED=false

# ── Billing & Business Logic ──
MIN_INVOICE_AMOUNT=1.00
MIN_FEE_USD=0.05
WELCOME_CREDIT_AMOUNT=5.00
# Extra credit bonus for users who sign up via an affiliate link (on top of welcome credit)
AFFILIATE_SIGNUP_BONUS=5.00

# Platform wallet to receive merchant fee credits (STABLECOINS ONLY: USDT/USDC)
PLATFORM_FEE_WALLET_EVM=0x
# Optional: custom Polygon RPC URL (defaults to public endpoints)
POLYGON_RPC_URL=""
# Float management (AAVE integration)
PLATFORM_WALLET_ADDRESS=""
AAVE_POOL_ADDRESS=""

# ── Email Configuration ──
# Resend (recommended for production)
# Get from: https://resend.com -> API Keys
RESEND_API_KEY=""
FROM_EMAIL="KnotEngine <noreply@yourdomain.com>"

# Gmail SMTP (alternative, for local development)
# Get from: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT=587

# ── Media Storage ──
# Get from: https://cloudinary.com -> Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── OAuth Providers ──
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:5052/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub: https://github.com/settings/developers
# Redirect URI: http://localhost:5052/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Developer Tools ──
# API key for developer tools / testing
KNOT_API_KEY=""
KNOT_WEBHOOK_SECRET=""

# Allow webhook simulation (development only)
ALLOW_SIMULATION=""
# Test email recipient (development only)
TEST_EMAIL=""

# ── Testing ──
# Test email recipient (development only)
TEST_EMAIL=""