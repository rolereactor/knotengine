# ══════════════════════════════════════════════
# KnotEngine — Environment Configuration
# ══════════════════════════════════════════════
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local

# ── Environment ──
NODE_ENV=development

# ── Core Infrastructure (REQUIRED) ──────────────────────────────────────────
# MongoDB connection string (required, fail fast if missing)
DATABASE_URL="mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/knotengine?retryWrites=true&w=majority"

# NextAuth secret — generate with: openssl rand -base64 32
# Must be at least 16 characters (required, fail fast if missing)
AUTH_SECRET="change_me"

# Internal secret for Dashboard <-> API server-to-server calls
# Must be at least 16 characters (required, fail fast if missing)
INTERNAL_SECRET="change_me_generate_with_openssl_rand_hex"

# ── Core Infrastructure (OPTIONAL) ──────────────────────────────────────────
# Redis URL — if absent, the API falls back to in-memory queues (less resilient)
REDIS_URL="redis://localhost:6379"

# API server port (default: 5050)
PORT=5050

# ── Service URLs ────────────────────────────────────────────────────────────
# API base URL used by the Dashboard and Checkout apps
NEXT_PUBLIC_API_URL="http://localhost:5050"

# Checkout app public URL (used in payment links, emails)
NEXT_PUBLIC_CHECKOUT_URL="http://localhost:5051"
CHECKOUT_URL="http://localhost:5051"

# Dashboard app public URL (used in emails, links)
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:5052"
DASHBOARD_URL="http://localhost:5052"

# Public-facing API URL (used for Tatum webhook callbacks)
# Defaults to NEXT_PUBLIC_API_URL if not set
PUBLIC_URL="http://localhost:5050"

# CORS allowed origins — comma-separated list of dashboard/checkout origins
# Only enforced in production; development allows all origins
ALLOWED_ORIGINS=""

# ── Blockchain Providers (REQUIRED — at least one webhook secret) ───────────
# Tatum (BTC, LTC monitoring)
# Get from: https://dashboard.tatum.io
TATUM_API_KEY=""
TATUM_WEBHOOK_SECRET=""     # Required for Tatum webhook verification

# Alchemy (ETH, EVM tokens monitoring)
# Get from: https://www.alchemy.com -> Dashboard -> API Keys
ALCHEMY_API_KEY=""
ALCHEMY_AUTH_TOKEN=""
ALCHEMY_NOTIFY_WEBHOOK_ID=""
ALCHEMY_WEBHOOK_SIGNING_KEY=""  # Required for Alchemy webhook verification

# NOTE: At least one of ALCHEMY_WEBHOOK_SIGNING_KEY or TATUM_WEBHOOK_SECRET
# must be set. The API will fail to start without one.

# ── Blockchain Network ──────────────────────────────────────────────────────
# "bitcoin" for mainnet, "testnet" for testnet, "regtest" for local testing
BITCOIN_NETWORK="testnet"

# ── Deployment Mode ─────────────────────────────────────────────────────────
# Set to "true" to enable self-hosted mode (all features unlocked, no billing)
SELF_HOSTED=false

# ── Billing & Business Logic ────────────────────────────────────────────────
# Minimum invoice amount in USD (default: 1.00)
MIN_INVOICE_AMOUNT=1.00
# Minimum fee charged per invoice in USD (default: 0.05)
MIN_FEE_USD=0.05
# Welcome credit given to new merchants in USD (default: 5.00)
WELCOME_CREDIT_AMOUNT=5.00
# Extra credit bonus for users who sign up via an affiliate link (default: 5.00)
AFFILIATE_SIGNUP_BONUS=5.00

# ── Float Management (OPTIONAL) ─────────────────────────────────────────────
# Platform wallet to receive merchant fee credits (STABLECOINS ONLY: USDT/USDC)
PLATFORM_FEE_WALLET_EVM=0x
# Custom Polygon RPC URL (defaults to public endpoints if empty)
POLYGON_RPC_URL=""
# Wallet address for AAVE float investment (optional)
PLATFORM_WALLET_ADDRESS=""
# AAVE Pool contract address for yield accrual (optional)
AAVE_POOL_ADDRESS=""

# ── Email Configuration ─────────────────────────────────────────────────────
# Resend (recommended for production)
# Get from: https://resend.com -> API Keys
RESEND_API_KEY=""
FROM_EMAIL="KnotEngine <noreply@yourdomain.com>"

# Gmail SMTP (alternative, useful for local development)
# Get from: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT=587

# ── Media Storage (OPTIONAL) ────────────────────────────────────────────────
# Cloudinary — used for merchant logo uploads
# Get from: https://cloudinary.com -> Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── OAuth Providers (OPTIONAL) ──────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:5052/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub: https://github.com/settings/developers
# Redirect URI: http://localhost:5052/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Observability (OPTIONAL) ────────────────────────────────────────────────
# Sentry error tracking — leave blank to disable
# Get from: https://sentry.io -> Project -> Settings -> Client Keys
SENTRY_DSN=""

# Log level: debug | info | warn | error (default: debug in dev, info in prod)
LOG_LEVEL=""

# ── Developer Tools (OPTIONAL) ──────────────────────────────────────────────
# API key for developer tools / testing
KNOT_API_KEY=""
KNOT_WEBHOOK_SECRET=""

# Allow webhook simulation endpoints (development only, never set in prod)
ALLOW_SIMULATION=""

# Test email recipient (used by scripts/test-email.ts)
TEST_EMAIL=""
